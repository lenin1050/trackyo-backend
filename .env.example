# Render supplies PORT automatically; this value is for local development.
PORT=5000
# For Render, set MONGODB_URI in the existing service to the MongoDB Atlas
# connection string (mongodb+srv://...). Do not use the local development URI.
MONGODB_URI=mongodb://127.0.0.1:27017/trackyo
# Render must use a randomly generated secret of at least 32 characters.
JWT_SECRET=replace_with_a_secure_secret
NODE_ENV=development
# Optional OpenRouter transaction classifier. Keep the real key only in
# the Render environment; when unset, TrackYo uses its local parser/classifier.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_TIMEOUT_MS=15000
